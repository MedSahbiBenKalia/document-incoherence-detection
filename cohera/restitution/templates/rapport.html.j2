<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>COHERA — rapport de cohérence documentaire</title>
<style>
  :root {
    --encre: #16191d; --doux: #5b6472; --trait: #dfe3e8; --fond: #ffffff;
    --papier: #f7f8fa; --accent: #1f4e79;
    --critique: #a3123a; --elevee: #c1571a; --moyenne: #8a6d1b; --faible: #4a6b52;
    --vert: #2c6e49; --rouge: #a3123a;
    --marque: #fff2a8; --marque-encre: #16191d;
    --juste-fond: #f1f8f3; --fausse-fond: #fdf2f4;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --encre: #e7eaee; --doux: #9aa5b4; --trait: #2c333d; --fond: #14171b;
      --papier: #1b1f25; --accent: #7fb0e0;
      --critique: #ff7a9a; --elevee: #ffa76b; --moyenne: #ddc36a; --faible: #8fc4a3;
      --vert: #7fd1a4; --rouge: #ff7a9a;
      --marque: #5a4a12; --marque-encre: #ffe9a3;
      --juste-fond: #17251d; --fausse-fond: #26161b;
    }
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body {
    margin: 0; padding: 2.5rem 1.5rem 6rem;
    font: 16px/1.6 "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    color: var(--encre); background: var(--fond);
    overflow-wrap: break-word;
  }
  main { max-width: 60rem; margin: 0 auto; }
  h1, h2, h3 { font-family: "Segoe UI", system-ui, sans-serif; line-height: 1.25; }
  h1 { font-size: 1.9rem; margin: 0 0 .3rem; letter-spacing: -.01em; }
  h2 {
    font-size: 1.25rem; margin: 3.5rem 0 1rem; padding-bottom: .45rem;
    border-bottom: 2px solid var(--trait);
  }
  h2 .compte { color: var(--doux); font-weight: 400; font-size: .85em; }
  h3 { font-size: 1rem; margin: 2rem 0 .6rem; }
  p.chapeau { color: var(--doux); margin: .2rem 0 0; }
  .note { color: var(--doux); font-size: .87rem; }
  /* Le bleu de lien par défaut du navigateur est illisible sur le fond sombre : les
     renvois de la synthèse vers le dossier prennent la couleur d'accent du thème. */
  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: .15em; }
  a:hover { text-decoration: none; }

  .bandeau {
    display: flex; flex-wrap: wrap; gap: 1.6rem;
    margin: 1.8rem 0; padding: 1.1rem 1.3rem;
    background: var(--papier); border: 1px solid var(--trait); border-radius: 8px;
  }
  .bandeau div { min-width: 7rem; }
  .bandeau .val { font-size: 1.45rem; font-weight: 600; font-family: "Segoe UI", sans-serif; }
  .bandeau .lib { color: var(--doux); font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; }
  .ok { color: var(--vert); } .ko { color: var(--rouge); }

  /* ══ la bascule entre profils de jugement ═══════════════════════════════════════════
     Deux jeux de résultats sont rendus dans la page ; un seul est visible. Sans script,
     le profil retenu reste affiché et l'autre reste caché : la page ne montre jamais
     deux vérités à la fois, elle offre simplement moins. */
  .bascule {
    display: flex; flex-wrap: wrap; align-items: center; gap: .5rem;
    margin: 1.8rem 0 1rem;
  }
  .bascule .lib {
    color: var(--doux); font: .78rem/1 "Segoe UI", sans-serif;
    text-transform: uppercase; letter-spacing: .05em; margin-right: .3rem;
  }
  .bascule .cran {
    font: 600 .85rem/1 "Segoe UI", system-ui, sans-serif;
    color: var(--doux); background: var(--fond);
    border: 1px solid var(--trait); border-radius: 5px; padding: .5rem .85rem; cursor: pointer;
  }
  .bascule .cran:hover { border-color: var(--accent); color: var(--accent); }
  .bascule .cran.actif {
    color: var(--fond); background: var(--accent); border-color: var(--accent);
  }
  @media (prefers-color-scheme: dark) {
    .bascule .cran.actif { color: #0f1418; }
  }
  .bascule .cran:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .bascule .modele { color: var(--doux); font-size: .8rem; font-family: ui-monospace, monospace; }

  .constat {
    border: 1px solid var(--trait); border-left: 5px solid var(--doux);
    border-radius: 6px; padding: 1rem 1.2rem; margin-bottom: 1rem; background: var(--fond);
  }
  .constat.g-CRITIQUE { border-left-color: var(--critique); }
  .constat.g-ELEVEE   { border-left-color: var(--elevee); }
  .constat.g-MOYENNE  { border-left-color: var(--moyenne); }
  .constat.g-FAIBLE   { border-left-color: var(--faible); }
  /* Le bord GAUCHE dit la gravité, le CADRE dit si la détection est juste : deux
     informations orthogonales, deux supports distincts, aucune ne recouvre l'autre. */
  .constat.juste  { border-color: var(--vert); background: var(--juste-fond); }
  .constat.fausse { border-color: var(--rouge); background: var(--fausse-fond); }

  .entete { display: flex; flex-wrap: wrap; align-items: baseline; gap: .55rem; margin-bottom: .7rem; }
  .titre { font-weight: 600; font-family: "Segoe UI", sans-serif; }
  .etiq {
    font: 600 .7rem/1 "Segoe UI", sans-serif; text-transform: uppercase; letter-spacing: .04em;
    padding: .27rem .5rem; border-radius: 4px; background: var(--papier);
    border: 1px solid var(--trait); color: var(--doux);
  }
  .etiq.grave { color: var(--critique); border-color: currentColor; }
  .etiq.faute { color: var(--rouge); border-color: currentColor; }
  .etiq.juste { color: var(--vert); border-color: currentColor; }
  .pousse { margin-left: auto; }

  /* ══ le partage juste / faux, lisible sans lire ══════════════════════════════════ */
  h3.groupe {
    display: flex; align-items: baseline; gap: .5rem;
    margin: 2.2rem 0 .8rem; padding: .45rem .7rem; border-radius: 5px;
    border-left: 5px solid var(--doux); background: var(--papier);
  }
  h3.groupe.juste  { border-left-color: var(--vert);  color: var(--vert); }
  h3.groupe.fausse { border-left-color: var(--rouge); color: var(--rouge); }
  h3.groupe .marqueur { font-size: 1.1em; line-height: 1; }
  h3.groupe .note { margin-left: auto; text-align: right; flex: 1 1 14rem; }

  .faces { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  @media (max-width: 52rem) { .faces { grid-template-columns: 1fr; } }
  .face { background: var(--papier); border-radius: 5px; padding: .65rem .8rem; min-width: 0; }
  .face .ref { font: 600 .8rem "Segoe UI", sans-serif; color: var(--accent); }
  .face blockquote {
    margin: .35rem 0 0; padding-left: .7rem; border-left: 3px solid var(--trait);
    font-style: italic;
  }
  .explication { margin: .8rem 0 0; }

  /* ══ le texte intégral d'une clause ═══════════════════════════════════════════════
     Jamais tronqué, jamais résumé, et jamais réduit à « D1 §6.5 » : un lecteur qui n'a
     pas les procédures sous les yeux doit pouvoir juger sur pièces. */
  .texte {
    margin: .35rem 0 0; padding: .5rem .7rem;
    background: var(--fond); border: 1px solid var(--trait); border-radius: 4px;
    font-size: .95rem;
  }
  .texte .lib {
    display: block; color: var(--doux); font: .68rem/1.5 "Segoe UI", sans-serif;
    text-transform: uppercase; letter-spacing: .05em; margin-bottom: .2rem;
  }
  mark { background: var(--marque); color: var(--marque-encre); padding: 0 .1em; border-radius: 2px; }
  .cite {
    margin: .5rem 0 0; padding-left: .7rem; border-left: 3px solid var(--accent);
    font-style: italic;
  }

  table { border-collapse: collapse; width: 100%; font-size: .92rem; }
  .defile { overflow-x: auto; }
  th, td { text-align: left; padding: .48rem .6rem; border-bottom: 1px solid var(--trait); vertical-align: top; }
  th { font: 600 .78rem "Segoe UI", sans-serif; text-transform: uppercase;
       letter-spacing: .04em; color: var(--doux); }
  td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  tr.retenu td:first-child { border-left: 3px solid var(--vert); }
  tr.ecarte td:first-child { border-left: 3px solid var(--trait); }
  tr.juste  td:first-child { border-left: 3px solid var(--vert); }
  tr.fausse td:first-child { border-left: 3px solid var(--rouge); }
  tr.bande th {
    padding-top: 1rem; color: var(--encre); font-size: .82rem;
    border-bottom: 2px solid var(--trait);
  }
  tr.bande.juste  th { color: var(--vert); }
  tr.bande.fausse th { color: var(--rouge); }

  details { border: 1px solid var(--trait); border-radius: 6px; padding: .7rem .9rem; margin-bottom: .6rem; }
  details summary { cursor: pointer; font-family: "Segoe UI", sans-serif; }
  details ul { margin: .6rem 0 0; padding-left: 1.2rem; color: var(--doux); font-size: .9rem; }

  .encadre {
    background: var(--papier); border: 1px solid var(--trait);
    border-radius: 6px; padding: .9rem 1.1rem; margin: 1rem 0;
  }
  footer { margin-top: 4rem; padding-top: 1rem; border-top: 1px solid var(--trait); }
  code { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; font-size: .88em; }

  /* ══ rubriques repliables ═══════════════════════════════════════════════════════
     `<details>` natif : aucune dépendance, aucun script requis pour ouvrir une
     rubrique. Volontairement SANS attribut `name` — il ferait un accordéon exclusif,
     où ouvrir une rubrique en referme une autre. Toutes doivent pouvoir être
     ouvertes ensemble. Le repli est un confort de lecture : il ne retire rien. */
  details.rubrique { border: 0; border-radius: 0; padding: 0; margin: 0; }
  details.rubrique > summary { list-style: none; cursor: pointer; display: block; }
  details.rubrique > summary::-webkit-details-marker { display: none; }
  details.rubrique > summary::marker { content: ""; }
  /* `flex-wrap` n'est pas cosmétique : sans lui, le titre et son compte forment deux
     éléments flex incompressibles dont la somme dépasse un écran étroit, et c'est TOUTE
     la page qui déborde — le texte des clauses se retrouve coupé à droite. Mesuré à
     390 px. Le compte passe donc à la ligne plutôt que de pousser la page. */
  details.rubrique > summary h2 {
    display: flex; align-items: baseline; gap: .55rem; flex-wrap: wrap; min-width: 0;
  }
  details.rubrique > summary h2::before {
    content: "▸"; color: var(--doux); font-size: .8em; line-height: 1;
    display: inline-block; transition: transform .15s ease; flex: none;
  }
  details.rubrique[open] > summary h2::before { transform: rotate(90deg); }
  details.rubrique > summary:hover h2 { color: var(--accent); }
  details.rubrique > summary:hover h2::before { color: var(--accent); }
  details.rubrique > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  details.rubrique > summary h2 .compte { margin-left: auto; text-align: right; }
  details.rubrique > .corps { margin-top: 1.1rem; }

  .pilote { display: flex; flex-wrap: wrap; align-items: baseline; gap: .8rem; margin: 2.5rem 0 0; }
  .pilote button {
    font: 600 .78rem/1 "Segoe UI", system-ui, sans-serif; letter-spacing: .04em;
    text-transform: uppercase; color: var(--accent); background: var(--papier);
    border: 1px solid var(--trait); border-radius: 4px; padding: .45rem .7rem; cursor: pointer;
  }
  .pilote button:hover { border-color: var(--accent); }
  .pilote .note { flex: 1 1 22rem; margin: 0; }

  /* ══ zones non couvertes : ce qui a été écarté, et non seulement qu'on a écarté ══ */
  .zone {
    border: 1px solid var(--trait); border-left: 5px solid var(--doux);
    border-radius: 6px; padding: .8rem 1rem; margin: .7rem 0 0; background: var(--fond);
  }
  .zone .entete { margin-bottom: .45rem; }
  .zone p { margin: .35rem 0 0; }
  .etiq.brut { color: var(--accent); border-color: currentColor; }
  .etiq.annule { color: var(--rouge); border-color: currentColor; }

  .citation { margin-top: .7rem; }
  .citation .cote {
    font: 600 .78rem "Segoe UI", sans-serif; text-transform: uppercase;
    letter-spacing: .04em; color: var(--doux);
  }
  .citation.faux .cote { color: var(--rouge); }
  .citation.vraie .cote { color: var(--vert); }
  .citation blockquote {
    margin: .3rem 0 0; padding-left: .65rem; border-left: 3px solid var(--trait); font-style: italic;
  }
  .citation.faux blockquote { border-left-color: var(--rouge); }
  .citation.vraie blockquote { border-left-color: var(--vert); }
  .vide { color: var(--doux); font-style: italic; }

  /* ══ hypothèses d'alignement : deux termes, et les clauses qui les emploient ══ */
  .alias {
    border: 1px solid var(--trait); border-left: 5px solid var(--trait);
    border-radius: 6px; padding: .8rem 1rem; margin: .7rem 0 0; background: var(--fond);
  }
  .alias.retenu { border-left-color: var(--vert); }
  .alias .termes { font-weight: 600; font-family: "Segoe UI", sans-serif; }

  /* À l'impression, rien ne reste replié : une rubrique fermée sur le papier serait
     une perte, pas un confort. Le script rouvre tout avant `print`, ce garde-fou CSS
     couvre les moteurs qui n'exécutent pas le script. Le profil non retenu, lui, reste
     caché : le papier porte le profil qu'on a choisi de montrer. */
  @media print {
    details.rubrique > summary h2::before { content: ""; }
    .pilote, .bascule { display: none; }
  }
</style>
</head>
<body>
<main>

{#- ══════════════════════════════════════════════════════════════════════════════════
    Le dossier d'une détection. Écrit une fois, appelé pour les correctes, les erronées
    et le cas sans vérité terrain : trois copies du même bloc finiraient par diverger.
    `prefixe` désarme la collision d'identifiants entre les deux profils, qui portent
    les mêmes `id` de constatation.
    ══════════════════════════════════════════════════════════════════════════════════ -#}
{% macro carte(cl, prefixe) %}
{% set c = cl.constatation %}
<article class="constat g-{{ c.gravite or 'MOYENNE' }}{{ ' juste' if cl.correcte }}{{ ' fausse' if cl.erronee }}"
         id="{{ prefixe }}-{{ c.id }}">
  <div class="entete">
    {% if cl.correcte %}<span class="etiq juste">✓ détection correcte</span>
    {% elif cl.erronee %}<span class="etiq faute">✗ détection erronée</span>{% endif %}
    <span class="titre">
      {{ c.clause_a.libelle() }}{% if c.clause_b %} &nbsp;↔&nbsp; {{ c.clause_b.libelle() }}{% endif %}
    </span>
    <span class="etiq">{{ c.type }}</span>
    {% if c.gravite %}<span class="etiq {{ 'grave' if c.gravite == 'CRITIQUE' }}">{{ c.gravite }}</span>{% endif %}
    {% if c.nb_occurrences > 1 %}<span class="etiq">{{ c.nb_occurrences }} occurrences</span>{% endif %}
    {% if cl.identifiant %}<span class="etiq">{{ cl.identifiant }}</span>{% endif %}
    <span class="etiq pousse">criticité {{ "%.2f" | format(c.criticite) }}</span>
  </div>

  {% if cl.motif %}<p class="note" style="margin-top:0">{{ cl.motif }}</p>{% endif %}

  <div class="faces">
    {% for cote in [c.clause_a, c.clause_b] %}
    {% if cote %}
    <div class="face">
      <div class="ref">{{ cote.libelle() }}</div>
      <div class="texte">
        <span class="lib">Texte de la clause{% if cote.cite_le_texte_autonome %} · forme autonome{% endif %}</span>
        {{ cote.texte_affiche | surligner(cote.preuve) }}
      </div>
      {% if cote.cite_le_texte_autonome %}
      <p class="note" style="margin:.3rem 0 0">
        Le juge a cité la <em>forme autonome</em> de la clause — le texte de travail, où le
        sujet implicite est rétabli, et c'est celui que le prompt lui montre. La citation est
        littérale dans ce texte-là ; le document d'origine écrit :
        « {{ cote.texte_source }} »
      </p>
      {% endif %}
      {% if cote.preuve %}
      <blockquote class="cite">« {{ cote.preuve }} »</blockquote>
      {% else %}
      <p class="vide">Aucune citation de ce côté.</p>
      {% endif %}
    </div>
    {% endif %}
    {% endfor %}
  </div>

  {% if c.explication %}<p class="explication">{{ c.explication }}</p>{% endif %}

  <p class="note" style="margin-bottom:0">
    {% if c.clause_fautive == 'ARBITRAGE_REQUIS' %}
      <span class="etiq faute">arbitrage requis</span>
      Les deux documents sont de même niveau : aucune règle hiérarchique ne désigne de fautif.
    {% elif c.clause_fautive %}
      <span class="etiq faute">clause à corriger : {{ c.clause_fautive }}</span>
    {% else %}
      Aucune clause n'est désignée fautive : la plus permissive est celle du document de
      niveau supérieur, ce qui est l'ordre normal d'une déclinaison.
    {% endif %}
    &nbsp;·&nbsp; détecteur <code>{{ c.detecteur }}</code>, étage {{ c.etage }},
    confiance {{ "%.2f" | format(c.confiance) }} &nbsp;·&nbsp; statut {{ c.statut.value }}
    {% if c.cle_comparaison %} &nbsp;·&nbsp; clé de comparaison <code>{{ c.cle_comparaison }}</code>{% endif %}
  </p>

  {% if c.nb_occurrences > 1 %}
  <details style="margin-top:.7rem">
    <summary>Les {{ c.nb_occurrences }} manifestations de ce constat</summary>
    {% for o in c.occurrences %}
    <div class="texte">
      <span class="lib">{{ o.clause_a.libelle() }}{% if o.clause_b %} ↔ {{ o.clause_b.libelle() }}{% endif %}
        — détecteur {{ o.detecteur }}, étage {{ o.etage }}</span>
      {{ o.clause_a.texte_affiche | surligner(o.clause_a.preuve) }}
      {% if o.clause_b %}<br>{{ o.clause_b.texte_affiche | surligner(o.clause_b.preuve) }}{% endif %}
      {% if o.explication %}<p class="note" style="margin-bottom:0">{{ o.explication }}</p>{% endif %}
    </div>
    {% endfor %}
  </details>
  {% endif %}
</article>
{% endmacro %}

{% macro ligne(cl, prefixe, avec_verite) %}
{% set c = cl.constatation %}
<tr class="{{ 'juste' if cl.correcte }}{{ 'fausse' if cl.erronee }}">
  <td><a href="#{{ prefixe }}-{{ c.id }}">{{ c.clause_a.libelle() }}{% if c.clause_b %} ↔ {{ c.clause_b.libelle() }}{% endif %}</a>
    {% if c.nb_occurrences > 1 %} <span class="etiq">{{ c.nb_occurrences }} occurrences</span>{% endif %}</td>
  <td>{{ c.type }}</td>
  <td>{{ c.gravite or "—" }}</td>
  <td class="num">{{ "%.2f" | format(c.criticite) }}</td>
  <td><code>{{ c.detecteur }}</code> · étage {{ c.etage }}</td>
  <td>{% if c.clause_fautive == 'ARBITRAGE_REQUIS' %}arbitrage requis{% else %}{{ c.clause_fautive or "—" }}{% endif %}</td>
  {% if avec_verite %}
  <td>{% if cl.correcte %}✓{% elif cl.erronee %}✗{% endif %} {{ cl.identifiant or "—" }}</td>
  {% endif %}
</tr>
{% endmacro %}

<h1>Rapport de cohérence documentaire</h1>
<p class="chapeau">
  {% for d in rapport.documents %}<strong>{{ d.id }}</strong> {{ d.code }}
  ({{ d.nb_clauses }} clauses{% if d.niveau_hierarchique %}, niveau {{ d.niveau_hierarchique }}{% endif %}){% if not loop.last %} · {% endif %}{% endfor %}
  {% if rapport.date_execution %} — exécuté le {{ rapport.date_execution }}{% endif %}
  {% if rapport.date_reference %}, jugé à la date du {{ rapport.date_reference }}{% endif %}
</p>

{# ── Ce que le profil de jugement ne change pas : le corpus et le ciblage. ── #}
<div class="bandeau">
  <div><div class="val">{{ rapport.statistiques.paires_candidates }}</div><div class="lib">Paires examinées</div></div>
  <div><div class="val">{{ "%.0f%%" | format(rapport.statistiques.facteur_reduction * 100) }}</div><div class="lib">Réduction</div></div>
  <div><div class="val">{{ rapport.derogations_en_vigueur | length }}</div><div class="lib">Dérogations</div></div>
</div>

{% if profils | length > 1 %}
<div class="bascule" role="group" aria-label="Profil de jugement">
  <span class="lib">Profil de jugement</span>
  {% for p in profils %}
  <button type="button" class="cran{{ ' actif' if p.actif }}" data-cible="{{ p.cle }}"
          data-modele="{{ p.modele }}"
          aria-pressed="{{ 'true' if p.actif else 'false' }}">{{ p.libelle }}</button>
  {% endfor %}
  <span class="modele" data-role="modele-actif">{{ profil_actif.modele }}</span>
</div>
<p class="note" style="margin-top:-.4rem">
  Le modèle qui juge change ce que le système affirme. Les deux jeux de résultats sont dans
  cette page : la bascule change les rubriques <strong>1</strong> et <strong>2</strong> ainsi
  que les chiffres ci-dessous. Les rubriques 3 à 5 décrivent le corpus et le ciblage, que le
  profil ne change pas.
</p>
{% endif %}

{% for p in profils %}
<div data-profil="{{ p.cle }}"{% if not p.actif %} hidden{% endif %}>
  <div class="bandeau">
    <div><div class="val">{{ p.classements | length }}</div><div class="lib">Incohérences détectées</div></div>
    {% if p.restriction.actif %}
    <div><div class="val ok">{{ p.correctes | length }}</div><div class="lib">Détections correctes</div></div>
    <div><div class="val {{ 'ko' if p.erronees else 'ok' }}">{{ p.erronees | length }}</div><div class="lib">Détections erronées</div></div>
    <div>
      <div class="val">{{ p.restriction.detectees }}/{{ p.restriction.perimetre.incoherences | length }}</div>
      <div class="lib">Rappel (périmètre)</div>
    </div>
    <div><div class="val">{{ "%.2f" | format(p.restriction.precision) }}</div><div class="lib">Précision affichée</div></div>
    {% endif %}
    {% if p.bilan %}
    <div>
      <div class="val {{ 'ok' if p.bilan.conforme else 'ko' }}">{{ "%.0f%%" | format(p.bilan.taux * 100) }}</div>
      <div class="lib">Preuves littérales</div>
    </div>
    {% endif %}
  </div>

  {% if p.juge %}
  <div class="encadre">
    <strong>Profil de jugement : {{ p.libelle }}</strong> (<code>{{ p.juge.modele }}</code>).
    {% if p.actif and motif_du_profil %}{{ motif_du_profil }}{% endif %}
    <p class="note" style="margin-bottom:0">
      {{ p.juge.paires_soumises }} paires soumises · {{ p.juge.appels_reseau }} appels réseau
      · {{ p.juge.servis_par_cache }} servis par le cache · {{ p.juge.reparations }} réparations de format
      · {{ p.juge.verdicts_annules }} verdicts annulés pour preuve inventée
      ({{ "%.1f%%" | format(p.juge.taux_annulation * 100) }} des réponses).
    </p>
  </div>
  {% endif %}

  {# ── Le périmètre et la comparaison attendu / obtenu n'existent QUE si un fichier
       d'annotations a été fourni. Sans lui, ce bloc disparaît et le rapport présente
       tout ce qui a été détecté, sans jugement : c'est le cas d'usage réel. ── #}
  {% if p.restriction.actif %}
  {% set nb_attendues = p.restriction.perimetre.incoherences | length %}
  <div class="encadre">
    <strong>Attendu et obtenu :</strong>
    <strong>{{ p.restriction.detectees }} sur {{ nb_attendues }}</strong> incohérences du
    périmètre déclaré dans <code>{{ p.restriction.perimetre.source }}</code> sont détectées.
    {% if p.restriction.non_detectees %}
      Non détectées : {{ p.restriction.non_detectees | join(", ") }}.
    {% endif %}
    <p class="note" style="margin-bottom:0">
      Les {{ p.classements | length }} détections sont <strong>toutes</strong> affichées,
      les {{ p.erronees | length }} erronées comprises : masquer ce que le système affirme à
      tort rendrait ce rapport flatteur et faux. Une détection est dite correcte quand elle
      correspond à une incohérence annotée, <em>même hors du périmètre chiffré</em> — d'où
      un compte d'erronées qui suit le barème <strong>global</strong> de
      <code>cohera evaluer</code> et non son barème « périmètre 7 jours », lequel neutralise
      les cas hors périmètre et affiche donc parfois un faux positif de moins.
      {% if p.restriction.ecartees %}
        Restreints au périmètre en revanche, parce qu'ils décrivent le contexte et non une
        affirmation : {{ p.restriction.abstentions_ecartees }} abstention(s) et
        {{ p.restriction.hypotheses_ecartees }} hypothèse(s) d'alignement sont hors des
        rubriques ci-dessous — le rapport JSON, lui, les conserve toutes.
      {% endif %}
    </p>
  </div>
  {% endif %}
</div>
{% endfor %}

{% if ablation_profils %}
<h3>Le choix du profil, et ce que l'autre aurait donné</h3>
<p class="note">
  Aucun des deux profils n'atteint les deux critères durs à la fois : le local privilégie la
  précision, le distant le rappel. Ce tableau dit ce que l'arbitrage a coûté ; la bascule
  ci-dessus permet de lire chaque profil en détail.
</p>
<div class="defile">
<table>
  <thead><tr><th>Profil</th><th class="num">Soumises</th><th class="num">Réparations</th>
  <th class="num">Constatations</th><th class="num">Précision</th><th class="num">Rappel</th>
  <th class="num">Faux positifs</th></tr></thead>
  <tbody>
  {% for p in ablation_profils %}
    <tr>
      <td>{{ p.nom }}{% if p.retenu %} <span class="etiq">retenu</span>{% endif %}</td>
      <td class="num">{{ p.soumises }}</td><td class="num">{{ p.reparations }}</td>
      <td class="num">{{ p.constatations }}</td>
      <td class="num">{{ "%.2f" | format(p.precision) }}</td>
      <td class="num">{{ p.rappel }}</td><td class="num">{{ p.faux_positifs }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

<div class="pilote" id="pilote">
  <p class="note">
    Les rubriques sont <strong>repliées</strong> : cliquez un titre pour la dérouler.
    Rien n'est tronqué ni résumé — le repli est un confort de lecture, et elles peuvent
    toutes être ouvertes en même temps. L'impression rouvre tout.
  </p>
</div>

{# ══════════════════════════════════════════════════ 1. CONSTATATIONS ══ #}
<details class="rubrique">
<summary>
  <h2>1. Constatations
    {% for p in profils %}
    <span class="compte" data-profil="{{ p.cle }}"{% if not p.actif %} hidden{% endif %}>— {{ p.classements | length }} détection{{ "s" if p.classements | length > 1 }}{% if p.restriction.actif %}, dont {{ p.erronees | length }} erronée{{ "s" if p.erronees | length > 1 }}{% endif %}</span>
    {% endfor %}
  </h2>
</summary>
<div class="corps">
<p class="note">
  La synthèse : une ligne par détection, pour embrasser d'un coup d'œil ce qui est en cause.
  Le dossier complet de chacune — texte intégral des deux clauses, citations exactes,
  explication — est la rubrique suivante.
</p>

{% for p in profils %}
<div data-profil="{{ p.cle }}"{% if not p.actif %} hidden{% endif %}>
{% if not p.classements %}
<p class="note">Aucune incohérence constatée sur ce corpus.</p>
{% else %}
<div class="defile">
<table>
  <thead><tr>
    <th>Clauses en cause</th><th>Type</th><th>Gravité</th>
    <th class="num">Criticité</th><th>Origine</th><th>Clause à corriger</th>
    {% if p.restriction.actif %}<th>Vérité terrain</th>{% endif %}
  </tr></thead>
  <tbody>
  {% if p.restriction.actif %}
    {% if p.correctes %}
    <tr class="bande juste"><th colspan="7">✓ Détections correctes — {{ p.correctes | length }}</th></tr>
    {% for cl in p.correctes %}{{ ligne(cl, p.cle, true) }}{% endfor %}
    {% endif %}
    {% if p.erronees %}
    <tr class="bande fausse"><th colspan="7">✗ Détections erronées — {{ p.erronees | length }}</th></tr>
    {% for cl in p.erronees %}{{ ligne(cl, p.cle, true) }}{% endfor %}
    {% endif %}
  {% else %}
    {% for cl in p.classements %}{{ ligne(cl, p.cle, false) }}{% endfor %}
  {% endif %}
  </tbody>
</table>
</div>
{% endif %}
</div>
{% endfor %}

</div>
</details>

{# ═══════════════════════════════════════ 2. INCOHÉRENCES DÉTECTÉES ══ #}
<details class="rubrique">
<summary>
  <h2>2. Incohérences détectées
    {% for p in profils %}
    <span class="compte" data-profil="{{ p.cle }}"{% if not p.actif %} hidden{% endif %}>— {{ p.classements | length }}, dossier complet</span>
    {% endfor %}
  </h2>
</summary>
<div class="corps">
<p class="note">
  Tout ce dont le système dispose sur chaque détection : les deux clauses avec leur
  <strong>texte intégral</strong>, la citation exacte qui fonde le verdict — surlignée à sa
  place dans le texte, puis reprise seule —, le type d'incohérence, le détecteur qui l'a
  produite, l'étage de la cascade, la criticité et l'explication.
</p>

{% for p in profils %}
<div data-profil="{{ p.cle }}"{% if not p.actif %} hidden{% endif %}>
{% if not p.classements %}
<p class="note">Aucune incohérence détectée sur ce corpus.</p>
{% elif p.restriction.actif %}
  {% if p.correctes %}
  <h3 class="groupe juste">
    <span class="marqueur">✓</span> Détections correctes — {{ p.correctes | length }}
    <span class="note">Chacune correspond à une incohérence de la vérité terrain.</span>
  </h3>
  {% for cl in p.correctes %}{{ carte(cl, p.cle) }}{% endfor %}
  {% endif %}

  {% if p.erronees %}
  <h3 class="groupe fausse">
    <span class="marqueur">✗</span> Détections erronées — {{ p.erronees | length }}
    <span class="note">Affichées, jamais masquées : c'est ce que le système affirme à tort.</span>
  </h3>
  {% for cl in p.erronees %}{{ carte(cl, p.cle) }}{% endfor %}
  {% endif %}
{% else %}
  {% for cl in p.classements %}{{ carte(cl, p.cle) }}{% endfor %}
{% endif %}
</div>
{% endfor %}

</div>
</details>

{# ═══════════════════════════════════════ 3. HYPOTHÈSES D'ALIGNEMENT ══ #}
<details class="rubrique">
<summary>
  <h2>3. Hypothèses d'alignement <span class="compte">— {{ rapport.hypotheses_alias | length }}</span></h2>
</summary>
<div class="corps">
<p class="note">
  Deux documents ne parlent pas le même vocabulaire. Pour rapprocher leurs clauses, le
  système pose des équivalences entre termes — « Responsable QSE » et « Référent sécurité »
  désignent-ils la même personne ? Ces équivalences sont des <strong>hypothèses</strong>,
  pas des faits : elles sont listées ici pour être révisées. Une seule d'entre elles qui
  serait fausse suffirait à produire des constatations infondées. Chacune montre
  <strong>les clauses qui emploient les deux termes</strong>, avec leur texte : c'est sur
  ces phrases-là, et non sur deux mots isolés, que l'équivalence se juge.
</p>

{% if rapport.hypotheses_alias %}
{% for h in rapport.hypotheses_alias %}
<article class="alias {{ 'retenu' if h.retenu else '' }}">
  <div class="entete">
    <span class="termes">« {{ h.libelle_a }} » &nbsp;≡&nbsp; « {{ h.libelle_b }} »</span>
    <span class="etiq"><code>{{ h.methode }}</code></span>
    {% if h.score_vectoriel %}<span class="etiq">score {{ "%.3f" | format(h.score_vectoriel) }}</span>{% endif %}
    <span class="etiq pousse {{ 'juste' if h.retenu else 'faute' }}">
      {{ "retenue" if h.retenu else "écartée" }}</span>
  </div>
  {% if h.justification %}<p class="note">{{ h.justification }}</p>{% endif %}

  {% if h.clauses_a or h.clauses_b %}
  <div class="faces">
    {% for terme, refs in [(h.libelle_a, h.clauses_a), (h.libelle_b, h.clauses_b)] %}
    <div class="face">
      <div class="ref">Clauses employant « {{ terme }} » — {{ refs | length }}</div>
      {% for ref in refs %}
      <div class="texte">
        <span class="lib">{{ ref.libelle() }}</span>
        {{ ref.texte() }}
      </div>
      {% else %}
      <p class="vide">Aucune clause recensée pour ce terme.</p>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="note">Les clauses employant ces termes n'ont pas été recensées pour cette exécution.</p>
  {% endif %}
</article>
{% endfor %}
{% else %}
<p class="note">Aucune hypothèse d'alignement n'a été posée pour ce corpus.</p>
{% endif %}

</div>
</details>

{# ══════════════════════════════════════════ 4. ZONES NON COUVERTES ══ #}
<details class="rubrique">
<summary>
  <h2>4. Zones non couvertes <span class="compte">— {{ rapport.abstentions | length }} paire{{ "s" if rapport.abstentions | length > 1 }}</span></h2>
</summary>
<div class="corps">
<p class="note">
  Ce que le système n'a <strong>pas</strong> tranché, sur le profil retenu. Ces paires ont
  été examinées et sont restées sans verdict : elles ne sont ni déclarées cohérentes, ni
  déclarées incohérentes. Elles relèvent d'une revue humaine. Les taire donnerait l'illusion
  d'une couverture complète.
</p>
<p class="note">
  Chaque paire montre <strong>le texte des deux clauses</strong> puis ce qui a été écarté,
  et pas seulement qu'on a écarté quelque chose : le verdict que le juge avait rendu, la
  confiance qu'il s'accordait, et la raison pour laquelle ce verdict n'a pas été retenu. Là
  où la citation produite n'existait pas dans le texte affiché juste au-dessus, elle est
  montrée telle quelle — c'est le garde-fou n°1 au travail, et la seule façon de vérifier
  qu'il travaille.
</p>

{% for groupe in abstentions %}
<details>
  <summary><strong>{{ groupe.nombre }}</strong> — {{ groupe.libelle }}</summary>
  {% if groupe.raison %}<p class="note">{{ groupe.raison }}</p>{% endif %}

  {% for a in groupe.paires %}
  <article class="zone">
    <div class="entete">
      <span class="titre">
        {{ a.clause_a.libelle() }}{% if a.clause_b %} &nbsp;↔&nbsp; {{ a.clause_b.libelle() }}{% endif %}
      </span>
      {% if a.verdict_brut %}
        <span class="etiq brut">verdict rendu : {{ a.verdict_brut }}</span>
        <span class="etiq">confiance {{ "%.2f" | format(a.confiance) }}</span>
        <span class="etiq annule pousse">non retenu</span>
      {% else %}
        <span class="etiq pousse">aucun verdict exploitable</span>
      {% endif %}
    </div>

    <div class="faces">
      {% for ref in [a.clause_a, a.clause_b] %}
      {% if ref %}
      <div class="face">
        <div class="ref">{{ ref.libelle() }}</div>
        <div class="texte">
          <span class="lib">Texte de la clause</span>
          {{ ref.texte() }}
        </div>
      </div>
      {% endif %}
      {% endfor %}
    </div>

    {% set glose = libelles_verdicts.get(a.verdict_brut | upper) %}
    {% if glose %}
    <p class="note">Le juge répondait : {{ glose }}.</p>
    {% endif %}
    {% if a.explication %}<p class="note">{{ a.explication }}</p>{% endif %}

    {% for c in a.preuve_invalide %}
    <div class="citation {{ 'vraie' if c.litterale else 'faux' }}">
      <div class="cote">
        Côté {{ c.cote }} · {{ c.clause }} —
        {{ "citation littérale, vérifiée" if c.litterale else "citation introuvable dans la clause" }}
      </div>
      {% if c.citation %}
      <blockquote>« {{ c.citation }} »</blockquote>
      {% else %}
      <p class="vide">Aucune citation produite — un verdict sans preuve ne vaut pas mieux
        qu'un verdict mal cité.</p>
      {% endif %}
    </div>
    {% endfor %}
  </article>
  {% endfor %}
</details>
{% else %}
<p class="note">Toutes les paires examinées ont reçu un verdict.</p>
{% endfor %}

{% if rapport.limites %}
<h3>Limites connues de cette exécution</h3>
<ul class="note">{% for limite in rapport.limites %}<li>{{ limite }}</li>{% endfor %}</ul>
{% endif %}

</div>
</details>

{# ══════════════════════════════════════ 5. DÉROGATIONS EN VIGUEUR ══ #}
<details class="rubrique">
<summary>
  <h2>5. Dérogations en vigueur <span class="compte">— {{ rapport.derogations_en_vigueur | length }}</span></h2>
</summary>
<div class="corps">
<p class="note">
  Des conflits <em>apparents</em> qui n'en sont pas : une clause déroge explicitement à une
  autre, avec une justification, un approbateur et une échéance. Elles sont listées pour que
  l'auditeur sache qu'elles existent et quand elles expirent — jamais signalées comme des
  incohérences. Elles ne sont <strong>pas</strong> filtrées par le périmètre : une exemption
  en vigueur doit se voir, quel que soit le barème.
</p>

{% if rapport.derogations_en_vigueur %}
{% for d in rapport.derogations_en_vigueur %}
<article class="constat">
  <div class="entete">
    <span class="titre">{{ d.clause_a.libelle() }} &nbsp;déroge à&nbsp; {{ d.cible }}</span>
    <span class="etiq pousse">échéance {{ d.echeance or "—" }}</span>
  </div>
  <div class="faces">
    <div class="face">
      <div class="ref">{{ d.clause_a.libelle() }} — la clause qui déroge</div>
      <div class="texte">
        <span class="lib">Texte de la clause</span>
        {{ d.clause_a.texte_affiche | surligner(d.clause_a.preuve) }}
      </div>
    </div>
    {% if d.clause_b %}
    <div class="face">
      <div class="ref">{{ d.clause_b.libelle() }} — la clause visée</div>
      <div class="texte">
        <span class="lib">Texte de la clause</span>
        {{ d.clause_b.texte() }}
      </div>
    </div>
    {% endif %}
  </div>
  <p class="note" style="margin-bottom:0">
    <strong>Justification :</strong> {{ d.justification or "—" }} &nbsp;·&nbsp;
    <strong>Approbateur :</strong> {{ d.approbateur or "—" }}
  </p>
</article>
{% endfor %}
{% else %}
<p class="note">Aucune dérogation en vigueur à la date de référence.</p>
{% endif %}
</div>
</details>

<footer>
  <p class="note">
    {% if bilan %}
    <strong>Preuves littérales : {{ bilan.verifiees }}/{{ bilan.total }} vérifiées.</strong>
    Chaque citation de ce rapport est une sous-chaîne exacte du texte d'origine, contrôlée
    programmatiquement avant publication. Une citation reformulée annule le verdict qui la porte.
    {% endif %}
  </p>
  <p class="note">
    COHERA — détection d'incohérences inter-documents QHSE. Corpus
    <code>{{ rapport.corpus }}</code> · {{ rapport.statistiques.paires_candidates }} paires
    examinées sur {{ rapport.statistiques.paires_theoriques }} théoriquement possibles.
  </p>
</footer>

</main>

<script>
/* Confort de lecture, jamais de rétention d'information.
   Trois choses, et aucune n'est indispensable à la lecture : la bascule entre profils de
   jugement, un bouton « tout déplier », et la réouverture de TOUT avant impression pour
   qu'une rubrique repliée ne disparaisse jamais du papier. Sans ce script, la page reste
   juste : le profil retenu est affiché, l'autre est caché, les <details> s'ouvrent seuls. */
(function () {
  "use strict";

  /* ── la bascule entre profils ─────────────────────────────────────────────────────
     Les deux jeux de résultats sont déjà dans le document : basculer ne fait que
     changer ce qui est visible. Aucun serveur, aucun appel, aucune donnée rechargée. */
  var crans = Array.prototype.slice.call(document.querySelectorAll(".bascule .cran"));
  var etiquetteModele = document.querySelector('[data-role="modele-actif"]');

  function basculer(cle) {
    Array.prototype.forEach.call(document.querySelectorAll("[data-profil]"), function (n) {
      n.hidden = n.dataset.profil !== cle;
    });
    crans.forEach(function (b) {
      var actif = b.dataset.cible === cle;
      b.classList.toggle("actif", actif);
      b.setAttribute("aria-pressed", String(actif));
      if (actif && etiquetteModele) { etiquetteModele.textContent = b.dataset.modele || ""; }
    });
  }

  crans.forEach(function (b) {
    b.addEventListener("click", function () { basculer(b.dataset.cible); });
  });

  /* ── le repli des rubriques ────────────────────────────────────────────────────── */
  var rubriques = Array.prototype.slice.call(document.querySelectorAll("details.rubrique"));
  var pilote = document.getElementById("pilote");
  if (!rubriques.length || !pilote) { return; }

  var bouton = document.createElement("button");
  bouton.type = "button";
  pilote.insertBefore(bouton, pilote.firstChild);

  function toutesOuvertes() {
    return rubriques.every(function (d) { return d.open; });
  }

  function rafraichir() {
    var ouvertes = toutesOuvertes();
    bouton.textContent = ouvertes ? "Tout replier" : "Tout déplier";
    bouton.setAttribute("aria-expanded", String(ouvertes));
  }

  bouton.addEventListener("click", function () {
    var ouvrir = !toutesOuvertes();
    rubriques.forEach(function (d) { d.open = ouvrir; });
    rafraichir();
  });
  rubriques.forEach(function (d) { d.addEventListener("toggle", rafraichir); });

  /* Un lien vers un constat doit ouvrir la rubrique qui le contient, sinon il pointe
     dans une section repliée et ne fait rien. */
  function ouvrirVers(cible) {
    if (!cible) { return; }
    var noeud = cible.parentNode;
    while (noeud && noeud.nodeType === 1) {
      if (noeud.tagName === "DETAILS") { noeud.open = true; }
      noeud = noeud.parentNode;
    }
    cible.scrollIntoView();
    rafraichir();
  }

  document.addEventListener("click", function (evenement) {
    var lien = evenement.target.closest ? evenement.target.closest('a[href^="#"]') : null;
    if (!lien) { return; }
    var cible = document.getElementById(lien.getAttribute("href").slice(1));
    if (!cible) { return; }
    evenement.preventDefault();
    ouvrirVers(cible);
  });

  /* Impression : on ouvre tout, y compris les <details> imbriqués (motifs d'abstention,
     occurrences regroupées), puis on rend exactement l'état d'avant. Le profil non
     retenu reste caché — le papier porte le profil qu'on a choisi de montrer. */
  var etats = [];
  window.addEventListener("beforeprint", function () {
    etats = Array.prototype.map.call(document.querySelectorAll("details"), function (d) {
      var etat = d.open;
      d.open = true;
      return etat;
    });
  });
  window.addEventListener("afterprint", function () {
    Array.prototype.forEach.call(document.querySelectorAll("details"), function (d, i) {
      d.open = etats[i];
    });
    rafraichir();
  });

  rafraichir();
})();
</script>
</body>
</html>
